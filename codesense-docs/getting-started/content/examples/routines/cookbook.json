{
  "examples": [
    {
      "kind": "schedule",
      "title": "Weekday review",
      "mcp": {
        "agent": "default",
        "mode": "fresh",
        "maxRuntime": "5m",
        "enabled": false,
        "dryRun": true,
        "id": "morning-review",
        "name": "Weekday review",
        "task": "Review the relevant stories and report the result.",
        "when": "weekdays 09:00",
        "tz": "UTC"
      },
      "yaml": {
        "id": "morning-review",
        "name": "Weekday review",
        "owner": "codesense",
        "where": {
          "kind": "team_workspace"
        },
        "policy": {
          "max_runtime": "5m"
        },
        "revision": 1,
        "agent": "default",
        "mode": "fresh",
        "task": "Review the relevant stories and report the result.",
        "triggers": [
          {
            "schedule": {
              "cron": "0 9 * * 1-5",
              "tz": "UTC"
            }
          }
        ]
      }
    },
    {
      "kind": "metadata_change",
      "title": "Story moves to review",
      "mcp": {
        "agent": "default",
        "mode": "fresh",
        "maxRuntime": "5m",
        "enabled": false,
        "dryRun": true,
        "id": "story-review",
        "name": "Story moves to review",
        "task": "Review the relevant stories and report the result.",
        "metadataTriggers": [
          {
            "selection": {
              "where": {
                "kinds": [
                  "story"
                ]
              }
            },
            "target": {
              "key": "status",
              "op": "eq",
              "value": "review"
            },
            "previous": {
              "key": "status",
              "op": "eq",
              "value": "in-progress"
            }
          }
        ]
      },
      "yaml": {
        "id": "story-review",
        "name": "Story moves to review",
        "owner": "codesense",
        "where": {
          "kind": "team_workspace"
        },
        "policy": {
          "max_runtime": "5m"
        },
        "revision": 1,
        "agent": "default",
        "mode": "fresh",
        "task": "Review the relevant stories and report the result.",
        "triggers": [
          {
            "event": {
              "kind": "metadata_change",
              "metadata": {
                "selection": {
                  "where": {
                    "kinds": [
                      "story"
                    ]
                  }
                },
                "target": {
                  "key": "status",
                  "op": "eq",
                  "value": "review"
                },
                "previous": {
                  "key": "status",
                  "op": "eq",
                  "value": "in-progress"
                }
              }
            }
          }
        ]
      }
    },
    {
      "kind": "inbox_idle",
      "title": "Unread mail at an idle prompt",
      "mcp": {
        "agent": "default",
        "mode": "fresh",
        "maxRuntime": "5m",
        "enabled": false,
        "dryRun": true,
        "id": "inbox-idle",
        "name": "Unread mail at an idle prompt",
        "task": "Inspect the idle sessions {{trigger.sessions}} and read their pending inbox messages. Report any work needing attention.",
        "events": [
          {
            "kind": "inbox_idle"
          }
        ]
      },
      "yaml": {
        "id": "inbox-idle",
        "name": "Unread mail at an idle prompt",
        "owner": "codesense",
        "where": {
          "kind": "team_workspace"
        },
        "policy": {
          "max_runtime": "5m"
        },
        "revision": 1,
        "agent": "default",
        "mode": "fresh",
        "task": "Inspect the idle sessions {{trigger.sessions}} and read their pending inbox messages. Report any work needing attention.",
        "triggers": [
          {
            "event": {
              "kind": "inbox_idle"
            }
          }
        ]
      }
    },
    {
      "kind": "agent_done",
      "title": "Agent finishes",
      "mcp": {
        "agent": "default",
        "mode": "fresh",
        "maxRuntime": "5m",
        "enabled": false,
        "dryRun": true,
        "id": "agent-done",
        "name": "Agent finishes",
        "task": "Inspect the completion of {{trigger.agent}}: {{trigger.status}} / {{trigger.summary}}. Review the result and report findings.",
        "events": [
          {
            "kind": "agent_done",
            "from_agent": "default"
          }
        ]
      },
      "yaml": {
        "id": "agent-done",
