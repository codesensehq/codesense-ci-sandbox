  * @param prefixedMessage - Optional pre-formatted message (takes precedence)
  * @param instanceId - Optional instance ID for multiremote (e.g., 'browserA')
  */
+// SW-CL-2i: guard the file-log write against a teardown write-after-end race.
+// During shutdown the LogWriter's stream is `.end()`ed (closeLogWriter), but its
+// singleton still reports "initialized" until the async end callback nulls the
+// stream. A late shutdown log line from the app then reaches writer.write() ->
+// stream.write() after end -> the WriteStream emits an unhandled 'error'
+// (ERR_STREAM_WRITE_AFTER_END) that crashes the driver process (exit 2) AFTER the
+// spec has fully passed. This ONLY neutralizes that specific benign teardown
+// case: it skips the write when the underlying stream is already ending/ended/
+// destroyed, and only swallows the ERR_STREAM_WRITE_AFTER_END code. Any other
+// write failure, and all normal in-test logging, are untouched.
+function safeWriterWrite(writer, formattedMessage) {
+    const stream = writer && writer.logStream;
+    if (stream && (stream.writableEnded || stream.writableFinished || stream.destroyed || stream.writable === false)) {
+        // Stream is closing/closed during teardown; drop this late line.
+        return;
+    }
+    if (stream && stream.listenerCount && stream.listenerCount('error') === 0) {
+        // The WriteStream reports write-after-end via an async 'error' event, not a
+        // thrown error. Attach a once-handler that swallows ONLY that code so a
+        // benign teardown race can't become an unhandled 'error' -> process crash.
+        stream.once('error', (err) => {
+            if (!err || err.code !== 'ERR_STREAM_WRITE_AFTER_END') {
+                throw err;
+            }
+        });
+    }
+    try {
+        writer.write(formattedMessage);
+    }
+    catch (err) {
+        if (!err || err.code !== 'ERR_STREAM_WRITE_AFTER_END') {
+            throw err;
+        }
+    }
+}
