          "hook_event": "UserPromptSubmit"
        },
        "agent_state": "thinking"
      },
      {
        "hook": "PreToolUse",
        "emitted": {
          "tab_session_id": "shell-turn-fixture",
          "status": "running",
          "hook_event": "PreToolUse"
        },
        "agent_state": "working"
      },
      {
        "hook": "PostToolUse",
        "emitted": {
          "tab_session_id": "shell-turn-fixture",
          "status": "running",
          "hook_event": "PostToolUse"
        },
        "agent_state": "thinking"
      },
      {
        "hook": "PreToolUse",
        "emitted": {
          "tab_session_id": "shell-turn-fixture",
          "status": "running",
          "hook_event": "PreToolUse"
        },
        "agent_state": "working"
      },
      {
        "hook": "PostToolUse",
        "emitted": {
          "tab_session_id": "shell-turn-fixture",
          "status": "running",
          "hook_event": "PostToolUse"
        },
        "agent_state": "thinking"
      },
      {
        "hook": "Stop",
        "emitted": {
          "tab_session_id": "shell-turn-fixture",
          "status": "done",
          "hook_event": "Stop"
        },
        "agent_state": "done"
      }
    ]
  }
