          "tab_session_id": "shell-turn-fixture",
          "status": "running",
          "hook_event": "UserPromptSubmit"
        },
        "agent_state": "thinking"
      },
      {
        "hook": "Stop",
        "emitted": {
          "tab_session_id": "shell-turn-fixture",
          "status": "done",
          "hook_event": "Stop"
        },
        "agent_state": "done"
      }
    ],
    "tool-turn": [
      {
        "hook": "UserPromptSubmit",
        "emitted": {
          "tab_session_id": "shell-turn-fixture",
