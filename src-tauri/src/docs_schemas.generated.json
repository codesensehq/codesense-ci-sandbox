    "src-tauri/src/agents/adapter/hermes.rs": "57ab631465858736dec7c392fe17715712788032122e339ccd73111a88fcd19f",
    "src-tauri/src/agents/adapter/opencode.rs": "d6b219c6af1261275a1bcc5d3892e7e0eeb1b911f221c5984552ce12f4333f0f",
    "src-tauri/src/agents/context.rs": "9b2215e069a9c9d859ebbd39f60f12357adb856db393768788ad77fa9fa3d32e",
    "src-tauri/src/agents/model.rs": "e6bda3a39850fa241c4345dafffecbc8db2667ff8e3346dc91eead6d52887721",
    "src-tauri/src/context_query/model.rs": "4e81c3eaa7ed4ea0dc93fe5017c7defe77655b124f0d5bc447557b646f42d345",
    "src-tauri/src/docs_schemas.rs": "d67976d753078dbeee4fe173776a3fd8caaa87c89b25232b71e2128d7d3e99b3",
    "src-tauri/src/queue_roles.rs": "b69b94aa10d5d0fc39d123858ea4cd42fe0d22b5af0c00b5479a3f9e8921b7ff",
    "src-tauri/src/routines/model.rs": "5bbdf683268ec98f285531eeb0313e051dd165f6ab71aa772127ff6674dd5a24",
    "src-tauri/src/session_usage/spend_caps.rs": "f0fdcc1b2d50cdd71becea9baff2da595dc24e79ba5670b734259093a359e5db"
  }
}
