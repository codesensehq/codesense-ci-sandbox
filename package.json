  "packageManager": "pnpm@10.16.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "jsdom"
    ],
    "ignoredBuiltDependencies": [
      "edgedriver",
      "geckodriver",
      "msw"
    ],
    "patchedDependencies": {
      "@xterm/addon-webgl@0.19.0": "patches/@xterm__addon-webgl@0.19.0.patch",
      "@wdio/tauri-service@1.3.0": "patches/@wdio__tauri-service@1.3.0.patch",
      "@xterm/addon-serialize@0.14.0": "patches/@xterm__addon-serialize@0.14.0.patch"
    },
    "overrides": {
      "deepmerge-ts@<8.0.0": "^8.0.2",
      "mocha>serialize-javascript": "^7.1.4",
      "get-uri>basic-ftp": "^6.2.5",
      "@puppeteer/browsers>extract-zip": "-",
      "@excalidraw/excalidraw>nanoid": "3.3.20",
      "@excalidraw/mermaid-to-excalidraw>nanoid": "^5.1.16",
      "lodash-es@<4.18.0": "^4.18.1",
      "@tailwindcss/typography>postcss-selector-parser": "6.1.5"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "pnpm gen:theme && tsc && vite build",
    "gen:docs": "pnpm gen:nav-kit && pnpm gen:theme && node scripts/generate-recipes-manifest.mjs && node scripts/generate-mcp-reference.mjs && node scripts/generate-pane-references.mjs && node scripts/generate-builtin-pane-examples.mjs && node scripts/generate-live-data-contract.mjs && node scripts/generate-primitives-reference.mjs && node scripts/generate-model-schemas.mjs && node scripts/generate-routine-cookbook.mjs && node scripts/generate-yaml-schemas.mjs && node scripts/generate-ui-mcp-crossref.mjs && node scripts/check-api-skew.mjs --docs && node scripts/generate-docs-search-index.mjs && node scripts/build-codesense-docs.mjs --handbook && node scripts/generate-docs-metadata.mjs",
    "docs:coverage": "node scripts/check-docs-coverage.mjs",
    "docs:refresh-mcp": "node scripts/generate-mcp-reference.mjs --queued-export && node scripts/generate-live-data-contract.mjs --queued-export && pnpm gen:docs",
    "gen:docs:check": "pnpm gen:nav-kit:check && pnpm gen:theme:check && node scripts/generate-recipes-manifest.mjs --check && node scripts/generate-mcp-reference.mjs --check && node scripts/generate-pane-references.mjs --check && node scripts/generate-builtin-pane-examples.mjs --check && node scripts/generate-live-data-contract.mjs --check && node scripts/generate-primitives-reference.mjs --check && node scripts/generate-model-schemas.mjs --check && node scripts/generate-routine-cookbook.mjs --check && node scripts/generate-yaml-schemas.mjs --check && node scripts/generate-ui-mcp-crossref.mjs --check && node scripts/check-api-skew.mjs --docs --check && node scripts/generate-docs-search-index.mjs --check && node scripts/build-codesense-docs.mjs --check-handbook && node scripts/generate-docs-metadata.mjs --check && node scripts/check-docs-api-examples.mjs",
    "gen:docs:check:pr": "DOCS_ALLOW_STALE_EXPORT=1 pnpm gen:docs:check",
    "build:emulator": "bash scripts/build-emulator.sh",
    "bench:emulator": "EMULATOR_BENCH=1 vitest run src-emulator/bench",
    "fixtures:dump": "UPDATE_FIXTURE_DUMPS=1 vitest run src/shared/terminal/__tests__/fixture-dumps.test.ts",
    "write-snapshot-fixtures": "UPDATE_SNAPSHOT_FIXTURES=1 vitest run src-emulator/snapshot-fixtures.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "pretest": "bash scripts/dev-worktree.test.sh",
    "test": "vitest run",
    "pretest:docs-gate": "bash scripts/dev-worktree.test.sh",
    "test:docs-gate": "sh -c 'vitest run scripts/ $(git ls-files \"*.guard.test.ts\" | grep -v \"^scripts/\") --maxWorkers=4 && pnpm test:node-scripts'",
    "test:dev-worktree": "bash scripts/dev-worktree.test.sh",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mock": "playwright test -c playwright.mock.config.ts",
    "build:webdriver": "pnpm gen:theme && vite build --mode webdriver",
    "tauri:build:unsigned": "echo 'Unsigned debug app: no Apple signing; updater artifacts skipped (no TAURI_SIGNING_PRIVATE_KEY needed)' && pnpm run tauri build --debug --config src-tauri/tauri.unsigned.conf.json",
    "test:rust": "bash scripts/test-rust.sh",
    "check:rust": "cd src-tauri && cargo check",
    "clippy:rust": "cd src-tauri && cargo clippy -p codesense -p codesense-host-proto -p codesense-pty-core -p codesense-fs-core -p codesense-session-server --lib -- -D warnings",
    "fmt:rust": "cd src-tauri && cargo fmt --check -p codesense-guards -p codesense -p codesense-host-proto -p codesense-pty-core -p codesense-fs-core -p codesense-session-server",
    "gen:theme": "tsx scripts/generate-theme-tokens.ts",
    "gen:theme:check": "tsx scripts/generate-theme-tokens.ts --check",
    "check:agent-row-layout": "node scripts/check-agent-row-layout.mjs",
    "lint": "node scripts/check-hardcoded-colors.mjs && node scripts/check-terminal-arch.mjs && node scripts/check-agent-cli-boundary.mjs && node scripts/check-agent-cli-boundary-ts.mjs && node scripts/check-context-walk.mjs && eslint . && prettier --check .",
    "check:terminal-arch": "node scripts/check-terminal-arch.mjs",
    "check:agent-cli-boundary": "node scripts/check-agent-cli-boundary.mjs",
    "check:agent-cli-boundary-ts": "node scripts/check-agent-cli-boundary-ts.mjs",
    "check:context-walk": "node scripts/check-context-walk.mjs",
    "check:api-skew": "node scripts/check-api-skew.mjs",
    "lint:fix": "eslint --fix . && prettier --write .",
    "tauri": "set -a; [ -f src-tauri/.env ] && . src-tauri/.env; set +a; tauri",
    "gen:verbs": "node scripts/generate-verb-registry.mjs --export",
    "gen:verbs:check": "node scripts/generate-verb-registry.mjs --check",
    "test:verbs-codegen": "node --test scripts/generate-verb-registry.node-test.mjs",
    "test:node-scripts": "node --test scripts/*.node-test.mjs src-tauri/resources/opencode/*.test.mjs",
    "format:files": "prettier --write",
    "lint:files": "eslint",
    "test:dashboard-kit": "playwright test -c playwright.dashboard-kit.config.ts",
    "test:frame-security": "playwright test -c playwright.frame-security.config.ts",
    "test:pane-harness": "playwright test -c playwright.pane-harness.config.ts",
    "test:conformance": "node scripts/run-conformance.mjs",
    "check:format:files": "prettier --check",
    "build:kit-editor": "node scripts/build-kit-editor.mjs",
    "gen:nav-kit": "tsx scripts/generate-nav-kit.tsx",
    "gen:nav-kit:check": "tsx scripts/generate-nav-kit.tsx --check"
  },
